# diploma-equivalence — runtime env reference
# Copy to `.env` for local Docker runs, or set via `dokku config:set` in prod.

# --- HTTP server ---------------------------------------------------------
# Port the FastAPI service listens on. Dokku sets this automatically; locally
# leave at 5000 to match the Dockerfile EXPOSE and the app.json healthcheck.
PORT=5000

# CORS allowlist (comma-separated origins; "*" only for dev).
CORS_ORIGINS=*

# --- Build provenance (populated by CI/Dockerfile build args) ------------
APP_VERSION=0.1.0
GIT_SHA=unknown
BUILD_DATE=unknown

# --- Embedding pipeline (only consumed by the offline match CLI) --------
# The HTTP service does NOT load the model at startup; these are read by the
# `python -m diploma_equivalence.cli` entry point when running batch matches.
# Set if you want the cache outside $HOME/.cache (e.g. on a mounted volume).
# HF_HOME=/var/lib/diploma-equivalence/hf-cache
# DIPLOMA_VAULT_ROOT=/var/lib/diploma-equivalence/vault

# --- Future: persistence backends (skeletons exist; not yet wired) ------
# POSTGRES_DSN=postgresql://user:pass@host:5432/diploma_equivalence
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
